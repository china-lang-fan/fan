导入 "字符串" 作为 字符串模块
导入 "测试" 作为 测试模块

函数 测试拆分()
    测试模块.断言相等(字符串模块.split("a,b,c", ","), ["a", "b", "c"])
    测试模块.断言相等(字符串模块.split("abc", ""), ["a", "b", "c"])
结束

函数 测试连接()
    测试模块.断言相等(字符串模块.join(["a", "b", "c"], "-"), "a-b-c")
结束

函数 测试查找()
    测试模块.断言相等(字符串模块.contains("abc", "b"), 真)
    测试模块.断言相等(字符串模块.contains("abc", "d"), 假)
    测试模块.断言相等(字符串模块.startsWith("abc", "a"), 真)
    测试模块.断言相等(字符串模块.endsWith("abc", "c"), 真)
    测试模块.断言相等(字符串模块.index("abc", "b"), 1)
    测试模块.断言相等(字符串模块.index("abc", "d"), -1)
结束

函数 测试截取()
    测试模块.断言相等(字符串模块.substring("abc", 1, 2), "b")
    测试模块.断言相等(字符串模块.substring("abc", 1), "bc")
结束

函数 测试转换()
    测试模块.断言相等(字符串模块.replace("abc", "b", "x"), "axc")
    测试模块.断言相等(字符串模块.trim("  abc  "), "abc")
    测试模块.断言相等(字符串模块.lower("AbC"), "abc")
    测试模块.断言相等(字符串模块.upper("AbC"), "ABC")
结束
