导入 "字符串" 作为 字符串模块
导入 "测试" 作为 测试模块

函数 测试拆分()
    测试模块.断言相等(字符串模块.拆分("a,b,c", ","), ["a", "b", "c"])
    测试模块.断言相等(字符串模块.拆分("abc", ""), ["a", "b", "c"])
结束

函数 测试连接()
    测试模块.断言相等(字符串模块.连接(["a", "b", "c"], "-"), "a-b-c")
结束

函数 测试查找()
    测试模块.断言相等(字符串模块.包含("abc", "b"), 真)
    测试模块.断言相等(字符串模块.包含("abc", "d"), 假)
    测试模块.断言相等(字符串模块.开头是("abc", "a"), 真)
    测试模块.断言相等(字符串模块.结尾是("abc", "c"), 真)
    测试模块.断言相等(字符串模块.位置("abc", "b"), 1)
    测试模块.断言相等(字符串模块.位置("abc", "d"), -1)
结束

函数 测试截取()
    测试模块.断言相等(字符串模块.截取("abc", 1, 2), "b")
    测试模块.断言相等(字符串模块.截取("abc", 1), "bc")
结束

函数 测试转换()
    测试模块.断言相等(字符串模块.替换("abc", "b", "x"), "axc")
    测试模块.断言相等(字符串模块.修剪("  abc  "), "abc")
    测试模块.断言相等(字符串模块.转小写("AbC"), "abc")
    测试模块.断言相等(字符串模块.转大写("AbC"), "ABC")
结束

函数 测试原生方法()
    测试模块.断言相等("abc".包含("b"), 真)
    测试模块.断言相等("abc".开头是("a"), 真)
    测试模块.断言相等("abc".结尾是("c"), 真)
    测试模块.断言相等("abc".位置("b"), 1)
    测试模块.断言相等("abc".截取(1, 2), "b")
    测试模块.断言相等("a,b,c".拆分(","), ["a", "b", "c"])
    测试模块.断言相等("abc".替换("b", "x"), "axc")
    测试模块.断言相等("  abc  ".修剪(), "abc")
    测试模块.断言相等("AbC".转小写(), "abc")
    测试模块.断言相等("AbC".转大写(), "ABC")
结束
