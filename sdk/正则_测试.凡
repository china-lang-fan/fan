导入 "正则" 作为 正则模块
导入 "系统" 作为 系统
导入 "测试" 作为 测试模块

函数 测试匹配()
    变量 是否匹配, 错误一 = 正则模块.匹配("\\d+", "a123b")
    变量 不匹配, 错误二 = 正则模块.匹配("^\\d+$", "a123b")
    测试模块.断言相等(错误一, 空)
    测试模块.断言相等(错误二, 空)
    测试模块.断言相等(是否匹配, 真)
    测试模块.断言相等(不匹配, 假)
结束

函数 测试查找()
    变量 首次, 错误一 = 正则模块.查找("\\d+", "a12b34")
    变量 全部, 错误二 = 正则模块.查找全部("\\d+", "a12b34")
    测试模块.断言相等(错误一, 空)
    测试模块.断言相等(错误二, 空)
    测试模块.断言相等(首次, "12")
    测试模块.断言相等(全部[1], "34")
结束

函数 测试分组()
    变量 分组结果, 错误一 = 正则模块.分组("([a-z]+)(\\d+)", "abc123")
    变量 全部分组结果, 错误二 = 正则模块.全部分组("(\\d+)", "1和22")
    测试模块.断言相等(错误一, 空)
    测试模块.断言相等(错误二, 空)
    测试模块.断言相等(分组结果[0], "abc123")
    测试模块.断言相等(分组结果[1], "abc")
    测试模块.断言相等(分组结果[2], "123")
    测试模块.断言相等(全部分组结果[1][1], "22")
结束

函数 测试无匹配分组()
    变量 分组结果, 错误值 = 正则模块.分组("\\d+", "abc")
    测试模块.断言相等(错误值, 空)
    测试模块.断言相等(系统.长度(分组结果), 0)
结束

函数 测试替换()
    变量 单次, 错误一 = 正则模块.替换("\\d+", "1和2", "#")
    变量 全部, 错误二 = 正则模块.全部替换("(\\w+)", "a b", "[$1]")
    测试模块.断言相等(错误一, 空)
    测试模块.断言相等(错误二, 空)
    测试模块.断言相等(单次, "#和2")
    测试模块.断言相等(全部, "[a] [b]")
结束

函数 测试拆分和转义()
    变量 拆分结果, 错误一 = 正则模块.拆分("[,;]", "a,b;c")
    变量 转义文本 = 正则模块.转义("a.b?")
    测试模块.断言相等(错误一, 空)
    测试模块.断言相等(拆分结果[2], "c")
    测试模块.断言相等(转义文本 != "a.b?", 真)
结束

函数 测试非法模式()
    变量 值, 错误值 = 正则模块.查找("(", "abc")
    测试模块.断言相等(错误值 != 空, 真)
    测试模块.断言相等(值, "")
结束
