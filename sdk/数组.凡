导入 "系统" 作为 系统
导入 "字符串" 作为 字符串模块

导出 函数 map(列表 数组, 变换) -> 数组
    变量 结果 = []
    遍历 列表 中的 项
        结果 = 系统.append(结果, 变换(项))
    结束
    返回 结果
结束

导出 函数 filter(列表 数组, 谓词) -> 数组
    变量 结果 = []
    遍历 列表 中的 项
        如果 谓词(项) 那么
            结果 = 系统.append(结果, 项)
        结束
    结束
    返回 结果
结束

导出 函数 reduce(列表 数组, 累积, 初始值)
    变量 结果 = 初始值
    遍历 列表 中的 项
        结果 = 累积(结果, 项)
    结束
    返回 结果
结束

导出 函数 find(列表 数组, 谓词)
    遍历 列表 中的 项
        如果 谓词(项) 那么
            返回 项, 真
        结束
    结束
    返回 空, 假
结束

导出 函数 some(列表 数组, 谓词) -> 布尔
    遍历 列表 中的 项
        如果 谓词(项) 那么
            返回 真
        结束
    结束
    返回 假
结束

导出 函数 every(列表 数组, 谓词) -> 布尔
    遍历 列表 中的 项
        如果 非 谓词(项) 那么
            返回 假
        结束
    结束
    返回 真
结束

导出 函数 contains(列表 数组, 值) -> 布尔
    遍历 列表 中的 项
        如果 项 == 值 那么
            返回 真
        结束
    结束
    返回 假
结束

导出 函数 index(列表 数组, 值) -> 整数
    变量 位置 = 0
    遍历 列表 中的 项
        如果 项 == 值 那么
            返回 位置
        结束
        位置++
    结束
    返回 -1
结束

导出 函数 slice(列表 数组, 开始 整数, 末位置 整数 = -1) -> 数组
    变量 长度值 = 系统.len(列表)
    如果 末位置 < 0 那么
        末位置 = 长度值
    结束
    如果 开始 < 0 那么
        开始 = 0
    结束
    如果 末位置 > 长度值 那么
        末位置 = 长度值
    结束
    变量 结果 = []
    变量 位置 = 0
    遍历 列表 中的 项
        如果 位置 >= 开始 且 位置 < 末位置 那么
            结果 = 系统.append(结果, 项)
        结束
        位置++
    结束
    返回 结果
结束

导出 函数 first(列表 数组)
    如果 系统.len(列表) == 0 那么
        返回 空
    结束
    返回 列表[0]
结束

导出 函数 last(列表 数组)
    变量 长度值 = 系统.len(列表)
    如果 长度值 == 0 那么
        返回 空
    结束
    返回 列表[长度值 - 1]
结束

导出 函数 reverse(列表 数组) -> 数组
    变量 结果 = []
    变量 位置 = 系统.len(列表) - 1
    当 位置 >= 0 循环
        结果 = 系统.append(结果, 列表[位置])
        位置--
    结束
    返回 结果
结束

函数 compareString(左 字符串, 右 字符串) -> 整数
    变量 位置 = 0
    遍历 左 中的 字符
        如果 位置 >= 系统.len(右) 那么
            返回 1
        结束
        变量 右编码 = 系统.ord(字符串模块.substring(右, 位置, 位置 + 1))
        变量 左编码 = 系统.ord(字符)
        如果 左编码 < 右编码 那么
            返回 -1
        结束
        如果 左编码 > 右编码 那么
            返回 1
        结束
        位置++
    结束
    如果 系统.len(右) > 位置 那么
        返回 -1
    结束
    返回 0
结束

函数 compareValues(左, 右) -> 整数
    判断
        当 系统.type(左) == "integer" 且 系统.type(右) == "integer"
            如果 左 < 右 那么
                返回 -1
            结束
            如果 左 > 右 那么
                返回 1
            结束
            返回 0
        当 (系统.type(左) == "integer" 或 系统.type(左) == "float") 且 (系统.type(右) == "integer" 或 系统.type(右) == "float")
            变量 左值 = 左 + 0.0
            变量 右值 = 右 + 0.0
            如果 左值 < 右值 那么
                返回 -1
            结束
            如果 左值 > 右值 那么
                返回 1
            结束
            返回 0
        当 系统.type(左) == "string" 且 系统.type(右) == "string"
            返回 compareString(左, 右)
    结束
    系统.fail("无法比较的值：" + 系统.type(左) + " 和 " + 系统.type(右))
    返回 0
结束

函数 insertSorted(列表 数组, 值, 取值) -> 数组
    变量 结果 = []
    变量 已插入 = 假
    遍历 列表 中的 项
        如果 非 已插入 且 compareValues(取值(值), 取值(项)) < 0 那么
            结果 = 系统.append(结果, 值)
            已插入 = 真
        结束
        结果 = 系统.append(结果, 项)
    结束
    如果 非 已插入 那么
        结果 = 系统.append(结果, 值)
    结束
    返回 结果
结束

函数 identity(值)
    返回 值
结束

导出 函数 sort(列表 数组) -> 数组
    变量 结果 = []
    遍历 列表 中的 项
        结果 = insertSorted(结果, 项, identity)
    结束
    返回 结果
结束

导出 函数 sortBy(列表 数组, 取值) -> 数组
    变量 结果 = []
    遍历 列表 中的 项
        结果 = insertSorted(结果, 项, 取值)
    结束
    返回 结果
结束

导出 函数 flatten(列表 数组) -> 数组
    变量 结果 = []
    遍历 列表 中的 项
        如果 系统.type(项) == "array" 那么
            遍历 项 中的 子项
                结果 = 系统.append(结果, 子项)
            结束
        否则
            结果 = 系统.append(结果, 项)
        结束
    结束
    返回 结果
结束

