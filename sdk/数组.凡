导入 "系统" 作为 系统
导入 "字符串" 作为 字符串模块

导出 函数 映射(列表 数组, 变换) -> 数组
    变量 结果 = []
    遍历 列表 中的 项
        结果 = 系统.追加(结果, 变换(项))
    结束
    返回 结果
结束

导出 函数 过滤(列表 数组, 谓词) -> 数组
    变量 结果 = []
    遍历 列表 中的 项
        如果 谓词(项) 那么
            结果 = 系统.追加(结果, 项)
        结束
    结束
    返回 结果
结束

导出 函数 归约(列表 数组, 累积, 初始值)
    变量 结果 = 初始值
    遍历 列表 中的 项
        结果 = 累积(结果, 项)
    结束
    返回 结果
结束

导出 函数 查找(列表 数组, 谓词)
    遍历 列表 中的 项
        如果 谓词(项) 那么
            返回 项, 真
        结束
    结束
    返回 空, 假
结束

导出 函数 任一(列表 数组, 谓词) -> 布尔
    遍历 列表 中的 项
        如果 谓词(项) 那么
            返回 真
        结束
    结束
    返回 假
结束

导出 函数 全部(列表 数组, 谓词) -> 布尔
    遍历 列表 中的 项
        如果 非 谓词(项) 那么
            返回 假
        结束
    结束
    返回 真
结束

导出 函数 包含(列表 数组, 值) -> 布尔
    遍历 列表 中的 项
        如果 项 == 值 那么
            返回 真
        结束
    结束
    返回 假
结束

导出 函数 位置(列表 数组, 值) -> 整数
    变量 当前位置 = 0
    遍历 列表 中的 项
        如果 项 == 值 那么
            返回 当前位置
        结束
        当前位置++
    结束
    返回 -1
结束

导出 函数 截取(列表 数组, 开始 整数, 末位置 整数 = -1) -> 数组
    变量 长度值 = 系统.长度(列表)
    如果 末位置 < 0 那么
        末位置 = 长度值
    结束
    如果 开始 < 0 那么
        开始 = 0
    结束
    如果 末位置 > 长度值 那么
        末位置 = 长度值
    结束
    变量 结果 = []
    变量 当前位置 = 0
    遍历 列表 中的 项
        如果 当前位置 >= 开始 且 当前位置 < 末位置 那么
            结果 = 系统.追加(结果, 项)
        结束
        当前位置++
    结束
    返回 结果
结束

导出 函数 首个(列表 数组)
    如果 系统.长度(列表) == 0 那么
        返回 空
    结束
    返回 列表[0]
结束

导出 函数 末个(列表 数组)
    变量 长度值 = 系统.长度(列表)
    如果 长度值 == 0 那么
        返回 空
    结束
    返回 列表[长度值 - 1]
结束

导出 函数 反转(列表 数组) -> 数组
    变量 结果 = []
    变量 当前位置 = 系统.长度(列表) - 1
    当 当前位置 >= 0 循环
        结果 = 系统.追加(结果, 列表[当前位置])
        当前位置--
    结束
    返回 结果
结束

函数 比较字符串(左 字符串, 右 字符串) -> 整数
    变量 当前位置 = 0
    遍历 左 中的 当前字符
        如果 当前位置 >= 系统.长度(右) 那么
            返回 1
        结束
        变量 右编码 = 系统.编码点(字符串模块.截取(右, 当前位置, 当前位置 + 1))
        变量 左编码 = 系统.编码点(当前字符)
        如果 左编码 < 右编码 那么
            返回 -1
        结束
        如果 左编码 > 右编码 那么
            返回 1
        结束
        当前位置++
    结束
    如果 系统.长度(右) > 当前位置 那么
        返回 -1
    结束
    返回 0
结束

函数 比较值(左, 右) -> 整数
    判断
        当 系统.类型名(左) == "integer" 且 系统.类型名(右) == "integer"
            如果 左 < 右 那么
                返回 -1
            结束
            如果 左 > 右 那么
                返回 1
            结束
            返回 0
        当 (系统.类型名(左) == "integer" 或 系统.类型名(左) == "float") 且 (系统.类型名(右) == "integer" 或 系统.类型名(右) == "float")
            变量 左值 = 左 + 0.0
            变量 右值 = 右 + 0.0
            如果 左值 < 右值 那么
                返回 -1
            结束
            如果 左值 > 右值 那么
                返回 1
            结束
            返回 0
        当 系统.类型名(左) == "string" 且 系统.类型名(右) == "string"
            返回 比较字符串(左, 右)
    结束
    系统.失败("无法比较的值：" + 系统.类型名(左) + " 和 " + 系统.类型名(右))
    返回 0
结束

函数 插入有序列表(列表 数组, 值, 取值) -> 数组
    变量 结果 = []
    变量 已插入 = 假
    遍历 列表 中的 项
        如果 非 已插入 且 比较值(取值(值), 取值(项)) < 0 那么
            结果 = 系统.追加(结果, 值)
            已插入 = 真
        结束
        结果 = 系统.追加(结果, 项)
    结束
    如果 非 已插入 那么
        结果 = 系统.追加(结果, 值)
    结束
    返回 结果
结束

函数 本身(值)
    返回 值
结束

导出 函数 排序(列表 数组) -> 数组
    变量 结果 = []
    遍历 列表 中的 项
        结果 = 插入有序列表(结果, 项, 本身)
    结束
    返回 结果
结束

导出 函数 按值排序(列表 数组, 取值) -> 数组
    变量 结果 = []
    遍历 列表 中的 项
        结果 = 插入有序列表(结果, 项, 取值)
    结束
    返回 结果
结束

导出 函数 展开(列表 数组) -> 数组
    变量 结果 = []
    遍历 列表 中的 项
        如果 系统.类型名(项) == "array" 那么
            遍历 项 中的 子项
                结果 = 系统.追加(结果, 子项)
            结束
        否则
            结果 = 系统.追加(结果, 项)
        结束
    结束
    返回 结果
结束

导出 函数 展开映射(列表 数组, 变换) -> 数组
    返回 展开(映射(列表, 变换))
结束
