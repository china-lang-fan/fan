导入 "进程" 作为 进程模块
导入 "文件" 作为 文件模块
导入 "系统" 作为 系统
导入 "测试" 作为 测试模块
导入 "转换" 作为 转换模块

函数 测试参数和脚本()
    变量 参数列表 = 进程模块.参数()
    测试模块.断言相等(系统.长度(参数列表) == 0, 真)
    测试模块.断言相等(系统.类型名(进程模块.脚本()), "string")
结束

函数 测试环境变量()
    变量 名称 = "FAN_SDK_TEST_ENV_" + 转换模块.转字符串(进程模块.进程号())
    测试模块.断言相等(进程模块.环境变量(名称), "")
    变量 错误值 = 进程模块.设置环境变量(名称, "凡")
    测试模块.断言相等(错误值, 空)
    测试模块.断言相等(进程模块.环境变量(名称), "凡")
结束

函数 测试进程编号()
    测试模块.断言相等(进程模块.进程号() > 0, 真)
    测试模块.断言相等(进程模块.父进程号() > 0, 真)
结束

函数 测试工作目录()
    变量 原目录 = 进程模块.工作目录()
    变量 临时目录, 临时错误 = 文件模块.临时目录()
    变量 切换错误 = 进程模块.切换目录(临时目录)
    变量 当前目录 = 进程模块.工作目录()
    变量 恢复错误 = 进程模块.切换目录(原目录)
    测试模块.断言相等(临时错误, 空)
    测试模块.断言相等(切换错误, 空)
    测试模块.断言相等(恢复错误, 空)
    测试模块.断言相等(当前目录, 临时目录)
结束

函数 测试执行命令()
    变量 结果, 错误值 = 进程模块.运行("go", ["version"])
    测试模块.断言相等(错误值, 空)
    测试模块.断言相等(结果["success"], 真)
    测试模块.断言相等(结果["exitCode"], 0)
    测试模块.断言相等(结果["stdout"] != "", 真)
结束

函数 测试非零退出码()
    变量 结果, 错误值 = 进程模块.运行("go", ["run", "不存在.go"])
    测试模块.断言相等(错误值, 空)
    测试模块.断言相等(结果["success"], 假)
    测试模块.断言相等(结果["exitCode"] != 0, 真)
结束

函数 测试启动失败()
    变量 结果, 错误值 = 进程模块.运行("fan-nonexistent-command", [])
    测试模块.断言相等(错误值 != 空, 真)
    测试模块.断言相等(结果["success"], 假)
结束

函数 测试标准输入和环境变量()
    变量 临时目录, 临时错误 = 文件模块.临时目录()
    变量 路径 = 文件模块.拼路径(临时目录, "main.go")
    变量 代码 = "package main\nimport (\n\"fmt\"\n\"io/ioutil\"\n\"os\"\n)\nfunc main(){\n数据, _ := ioutil.ReadAll(os.Stdin)\nfmt.Print(os.Getenv(\"FAN_TEST_VALUE\"))\nfmt.Print(string(数据))\n}"
    变量 模块错误 = 文件模块.写入(文件模块.拼路径(临时目录, "go.mod"), "module fan_process_test\n\ngo 1.20\n")
    变量 写入错误 = 文件模块.写入(路径, 代码)
    测试模块.断言相等(临时错误, 空)
    测试模块.断言相等(模块错误, 空)
    测试模块.断言相等(写入错误, 空)
    变量 输出文本, 执行错误 = 进程模块.输出("go", ["run", "."], {"cwd": 临时目录, "input": "你好", "env": {"FAN_TEST_VALUE": "凡"}})
    测试模块.断言相等(执行错误, 空)
    测试模块.断言相等(输出文本, "凡你好")
结束
