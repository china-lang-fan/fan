导入 "系统" 作为 系统
导入 "时间" 作为 时间模块
导入 "测试" 作为 测试模块

函数 测试当前时间戳()
    变量 秒 = 时间模块.当前时间戳()
    变量 毫秒 = 时间模块.当前毫秒时间戳()
    测试模块.断言相等(秒 > 0, 真)
    测试模块.断言相等(毫秒 >= 秒 * 1000, 真)
结束

函数 测试格式化()
    变量 时间戳 = 0
    测试模块.断言相等(时间模块.格式化(时间戳, "2006-01-02"), "1970-01-01")
    测试模块.断言相等(时间模块.格式化当前时间(时间模块.日期格式) != "", 真)
    测试模块.断言相等(系统.长度(时间模块.今日日期文本()), 10)
结束

函数 测试解析()
    变量 时间戳, 错误值 = 时间模块.解析日期("2020-01-01")
    测试模块.断言相等(错误值, 空)
    测试模块.断言相等(时间戳 > 0, 真)
    测试模块.断言相等(时间模块.格式化(时间戳, 时间模块.日期格式), "2020-01-01")
结束

函数 测试解析失败()
    变量 时间戳, 错误值 = 时间模块.解析日期("bad")
    测试模块.断言相等(时间戳, 0)
    测试模块.断言相等(错误值 != 空, 真)
结束

函数 测试时间分量()
    变量 时间戳, 错误值 = 时间模块.解析(时间模块.默认格式, "2020-06-15 10:20:30")
    测试模块.断言相等(错误值, 空)
    变量 分量 = 时间模块.时间分量(时间戳)
    测试模块.断言相等(分量["year"], 2020)
    测试模块.断言相等(分量["month"], 6)
    测试模块.断言相等(分量["day"], 15)
    测试模块.断言相等(分量["hour"], 10)
结束

函数 测试时间加减()
    变量 时间戳 = 1000000
    测试模块.断言相等(时间模块.加秒(时间戳, 5), 1000005)
    测试模块.断言相等(时间模块.加分钟(时间戳, 1), 1000060)
    测试模块.断言相等(时间模块.加小时(时间戳, 1), 1003600)
    测试模块.断言相等(时间模块.加天数(时间戳, 1), 1086400)
结束
