导入 "文件" 作为 文件模块
导入 "数组" 作为 数组模块
导入 "测试" 作为 测试模块

函数 测试读写追加()
    变量 根目录, 临时错误 = 文件模块.tempDir("fan-sdk-")
    测试模块.断言相等(临时错误, 空)
    变量 文件路径 = 文件模块.join(根目录, "a.txt")
    测试模块.断言相等(文件模块.write(文件路径, "甲"), 空)
    变量 内容, 读取错误 = 文件模块.read(文件路径)
    测试模块.断言相等(读取错误, 空)
    测试模块.断言相等(内容, "甲")
    测试模块.断言相等(文件模块.append(文件路径, "乙"), 空)
    变量 追加内容, 追加读取错误 = 文件模块.read(文件路径)
    测试模块.断言相等(追加读取错误, 空)
    测试模块.断言相等(追加内容, "甲乙")
    测试模块.断言相等(文件模块.removeAll(根目录), 空)
结束

函数 测试复制移动删除()
    变量 根目录, 临时错误 = 文件模块.tempDir("fan-sdk-")
    测试模块.断言相等(临时错误, 空)
    变量 源文件 = 文件模块.join(根目录, "b.txt")
    变量 目标文件 = 文件模块.join(根目录, "c.txt")
    测试模块.断言相等(文件模块.write(源文件, "内容"), 空)
    测试模块.断言相等(文件模块.copy(源文件, 目标文件), 空)
    变量 复制内容, 复制错误 = 文件模块.read(目标文件)
    测试模块.断言相等(复制错误, 空)
    测试模块.断言相等(复制内容, "内容")
    变量 移动目标 = 文件模块.join(根目录, "d.txt")
    测试模块.断言相等(文件模块.move(目标文件, 移动目标), 空)
    测试模块.断言相等(文件模块.exists(目标文件), 假)
    测试模块.断言相等(文件模块.exists(移动目标), 真)
    测试模块.断言相等(文件模块.remove(移动目标), 空)
    测试模块.断言相等(文件模块.exists(移动目标), 假)
    测试模块.断言相等(文件模块.removeAll(根目录), 空)
结束

函数 测试目录信息()
    变量 根目录, 临时错误 = 文件模块.tempDir("fan-sdk-")
    测试模块.断言相等(临时错误, 空)
    变量 子目录 = 文件模块.join(根目录, "子目录")
    测试模块.断言相等(文件模块.ensureDir(子目录), 空)
    测试模块.断言相等(文件模块.exists(子目录), 真)
    测试模块.断言相等(文件模块.isDir(子目录), 真)
    测试模块.断言相等(文件模块.isFile(子目录), 假)
    变量 列表, 列表错误 = 文件模块.list(根目录)
    测试模块.断言相等(列表错误, 空)
    测试模块.断言相等(数组模块.contains(列表, "子目录/"), 真)
    变量 信息, 信息错误 = 文件模块.stat(子目录)
    测试模块.断言相等(信息错误, 空)
    测试模块.断言相等(信息["isDir"], 真)
    测试模块.断言相等(文件模块.removeAll(根目录), 空)
结束

函数 测试路径操作()
    变量 路径 = 文件模块.join("目录", "a.txt")
    测试模块.断言相等(文件模块.fileName(路径), "a.txt")
    测试模块.断言相等(文件模块.fileExtension(路径), ".txt")
    测试模块.断言相等(文件模块.exists(路径), 假)
结束

函数 测试临时文件()
    变量 文件路径, 错误值 = 文件模块.tempFile("fan-")
    测试模块.断言相等(错误值, 空)
    测试模块.断言相等(文件模块.write(文件路径, "临时"), 空)
    测试模块.断言相等(文件模块.isFile(文件路径), 真)
    测试模块.断言相等(文件模块.remove(文件路径), 空)
结束
