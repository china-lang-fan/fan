导入 "测试" 作为 测试模块

变量 记录 = []

函数 追加记录(文本 字符串)
    记录 = 追加(记录, 文本)
结束

函数 测试稍后执行顺序()
    记录 = []
    函数 执行()
        稍后 追加记录("第二")
        稍后 追加记录("第一")
    结束
    执行()
    测试模块.断言相等(记录, ["第一", "第二"])
结束

函数 测试抛出和捕获()
    变量 结果 = ""
    函数 执行()
        稍后 函数()
            结果 = 捕获()
        结束
        抛出 "失败"
    结束
    执行()
    测试模块.断言相等(结果, "失败")
结束

函数 测试捕获任意实例()
    模型 自定义异常
        变量 字符串 原因
    结束
    变量 结果 = ""
    函数 执行()
        稍后 函数()
            变量 异常 = 捕获()
            结果 = 异常.原因
        结束
        变量 异常 = 自定义异常()
        异常.原因 = "自定义"
        抛出 异常
    结束
    执行()
    测试模块.断言相等(结果, "自定义")
结束
