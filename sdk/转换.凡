导入 "系统" 作为 系统

@内建("intToString")
函数 整数转文本(值)
    返回 ""
结束

@内建("floatToString")
函数 小数转文本(值)
    返回 ""
结束

@内建("parseInt")
函数 解析整数值(值)
    返回 空, 空
结束

@内建("parseFloat")
函数 解析小数值(值)
    返回 空, 空
结束

@内建("parseBool")
函数 解析布尔值(值)
    返回 假, 空
结束

导出 函数 转字符串(值)
    判断 系统.类型名(值)
        为 "string"
            返回 值
        为 "integer"
            返回 整数转文本(值)
        为 "float"
            返回 小数转文本(值)
        为 "boolean"
            如果 值 那么
                返回 "真"
            结束
            返回 "假"
        为 "nil"
            返回 "空"
        为 "error"
            返回 值.消息
    结束
    返回 系统.类型名(值)
结束

导出 函数 转整数(值)
    判断 系统.类型名(值)
        为 "integer"
            返回 值
        为 "float"
            返回 系统.截断(值)
        为 "boolean"
            如果 值 那么
                返回 1
            结束
            返回 0
        为 "string"
            变量 结果, 错误值 = 解析整数值(值)
            返回 结果
    结束
    系统.失败("无法转换为整数：" + 系统.类型名(值))
    返回 0
结束

导出 函数 转小数(值)
    判断 系统.类型名(值)
        为 "integer"
            返回 值 + 0.0
        为 "float"
            返回 值
        为 "boolean"
            如果 值 那么
                返回 1.0
            结束
            返回 0.0
        为 "string"
            变量 结果, 错误值 = 解析小数值(值)
            返回 结果
    结束
    系统.失败("无法转换为小数：" + 系统.类型名(值))
    返回 0.0
结束

导出 函数 转布尔(值)
    判断 系统.类型名(值)
        为 "boolean"
            返回 值
        为 "integer"
            返回 值 != 0
        为 "float"
            返回 值 != 0.0
        为 "string"
            变量 结果, 错误值 = 解析布尔值(值)
            如果 错误值 == 空 那么
                返回 结果
            结束
            返回 值 != ""
        为 "nil"
            返回 假
        为 "array", "dict"
            返回 系统.长度(值) > 0
    结束
    返回 真
结束

导出 函数 解析整数(文本 字符串)
    返回 解析整数值(文本)
结束

导出 函数 解析小数(文本 字符串)
    返回 解析小数值(文本)
结束

导出 函数 解析布尔(文本 字符串)
    返回 解析布尔值(文本)
结束
