导入 "编码" 作为 编码模块
导入 "测试" 作为 测试模块

函数 测试JSON编码()
    变量 文本, 错误值 = 编码模块.jsonString({"name": "凡", "version": 1})
    测试模块.断言相等(错误值, 空)
    测试模块.断言相等(文本 != "", 真)
结束

函数 测试JSON解码()
    变量 值, 错误值 = 编码模块.parseJSON("{\"name\":\"凡\",\"items\":[1,2]}")
    测试模块.断言相等(错误值, 空)
    测试模块.断言相等(值["name"], "凡")
    测试模块.断言相等(值["items"][1], 2)
结束

函数 测试JSON错误()
    变量 值, 错误值 = 编码模块.parseJSON("{bad")
    测试模块.断言相等(值, 空)
    测试模块.断言相等(错误值 != 空, 真)
结束

函数 测试Base64()
    变量 编码 = 编码模块.base64String("凡")
    测试模块.断言相等(编码 != "", 真)
    变量 解码, 错误值 = 编码模块.parseBase64(编码)
    测试模块.断言相等(错误值, 空)
    测试模块.断言相等(解码, "凡")
结束

函数 测试URL()
    变量 编码 = 编码模块.urlQueryString("a b&c")
    测试模块.断言相等(编码 != "a b&c", 真)
    变量 解码, 错误值 = 编码模块.parseURLQuery(编码)
    测试模块.断言相等(错误值, 空)
    测试模块.断言相等(解码, "a b&c")
结束

函数 测试十六进制()
    变量 编码 = 编码模块.hexString("fan")
    测试模块.断言相等(编码, "66616e")
    变量 解码, 错误值 = 编码模块.parseHex(编码)
    测试模块.断言相等(错误值, 空)
    测试模块.断言相等(解码, "fan")
结束
