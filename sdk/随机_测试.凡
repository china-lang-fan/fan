导入 "随机" 作为 随机模块
导入 "系统" 作为 系统
导入 "数组" 作为 数组模块
导入 "测试" 作为 测试模块

函数 测试整数范围()
    变量 次数 = 0
    当 次数 < 50 循环
        变量 值 = 随机模块.int(10)
        测试模块.断言相等(值 >= 0, 真)
        测试模块.断言相等(值 < 10, 真)
        变量 区间值 = 随机模块.intRange(5, 10)
        测试模块.断言相等(区间值 >= 5, 真)
        测试模块.断言相等(区间值 < 10, 真)
        次数++
    结束
结束

函数 测试小数范围()
    变量 次数 = 0
    当 次数 < 50 循环
        变量 值 = 随机模块.float()
        测试模块.断言相等(值 >= 0.0, 真)
        测试模块.断言相等(值 < 1.0, 真)
        变量 区间值 = 随机模块.floatRange(2.0, 5.0)
        测试模块.断言相等(区间值 >= 2.0, 真)
        测试模块.断言相等(区间值 < 5.0, 真)
        次数++
    结束
结束

函数 测试布尔和概率()
    变量 随机布尔 = 随机模块.bool()
    测试模块.断言相等(随机布尔 == 真 或 随机布尔 == 假, 真)
    测试模块.断言相等(随机模块.chance(0.0), 假)
    测试模块.断言相等(随机模块.chance(1.0), 真)
结束

函数 测试选择()
    变量 列表 = [1, 2, 3]
    变量 值 = 随机模块.choice(列表)
    测试模块.断言相等(数组模块.contains(列表, 值), 真)
结束

函数 测试打乱和抽样()
    变量 列表 = [1, 2, 3, 4]
    变量 打乱结果 = 随机模块.shuffle(列表)
    测试模块.断言相等(系统.len(打乱结果), 4)
    测试模块.断言相等(数组模块.sort(打乱结果), [1, 2, 3, 4])
    变量 抽样结果 = 随机模块.sample(列表, 2)
    测试模块.断言相等(系统.len(抽样结果), 2)
    遍历 抽样结果 中的 值
        测试模块.断言相等(数组模块.contains(列表, 值), 真)
    结束
结束
