导入 "系统" 作为 系统

函数 charAt(文本 字符串, 位置 整数) -> 字符串
    变量 当前位置 = 0
    遍历 文本 中的 字符
        如果 当前位置 == 位置 那么
            返回 字符
        结束
        当前位置++
    结束
    返回 ""
结束

导出 函数 substring(文本 字符串, 开始 整数, 末位置 整数 = -1) -> 字符串
    变量 长度值 = 系统.len(文本)
    如果 末位置 < 0 那么
        末位置 = 长度值
    结束
    如果 开始 < 0 那么
        开始 = 0
    结束
    如果 末位置 > 长度值 那么
        末位置 = 长度值
    结束
    变量 结果 = ""
    变量 位置 = 0
    遍历 文本 中的 字符
        如果 位置 >= 开始 且 位置 < 末位置 那么
            结果 += 字符
        结束
        位置++
    结束
    返回 结果
结束

导出 函数 index(文本 字符串, 子串 字符串) -> 整数
    变量 文本长度 = 系统.len(文本)
    变量 子串长度 = 系统.len(子串)
    如果 子串长度 == 0 那么
        返回 0
    结束
    变量 位置 = 0
    当 位置 <= 文本长度 - 子串长度 循环
        如果 substring(文本, 位置, 位置 + 子串长度) == 子串 那么
            返回 位置
        结束
        位置++
    结束
    返回 -1
结束

导出 函数 contains(文本 字符串, 子串 字符串) -> 布尔
    返回 index(文本, 子串) >= 0
结束

导出 函数 startsWith(文本 字符串, 前缀 字符串) -> 布尔
    如果 系统.len(前缀) > 系统.len(文本) 那么
        返回 假
    结束
    返回 substring(文本, 0, 系统.len(前缀)) == 前缀
结束

导出 函数 endsWith(文本 字符串, 后缀 字符串) -> 布尔
    如果 系统.len(后缀) > 系统.len(文本) 那么
        返回 假
    结束
    变量 开始 = 系统.len(文本) - 系统.len(后缀)
    返回 substring(文本, 开始) == 后缀
结束

导出 函数 split(文本 字符串, 分隔符 字符串) -> 数组
    变量 结果 = []
    变量 块 = ""
    变量 位置 = 0
    变量 文本长度 = 系统.len(文本)
    变量 分隔符长度 = 系统.len(分隔符)
    当 位置 < 文本长度 循环
        如果 分隔符长度 > 0 且 位置 + 分隔符长度 <= 文本长度 且 substring(文本, 位置, 位置 + 分隔符长度) == 分隔符 那么
            结果 = 系统.append(结果, 块)
            块 = ""
            位置 += 分隔符长度
        否则
            如果 分隔符长度 == 0 那么
                结果 = 系统.append(结果, charAt(文本, 位置))
            否则
                块 += charAt(文本, 位置)
            结束
            位置++
        结束
    结束
    如果 分隔符长度 > 0 那么
        结果 = 系统.append(结果, 块)
    结束
    返回 结果
结束

导出 函数 join(列表 数组, 分隔符 字符串) -> 字符串
    变量 结果 = ""
    变量 位置 = 0
    遍历 列表 中的 项
        如果 位置 > 0 那么
            结果 += 分隔符
        结束
        结果 += 项
        位置++
    结束
    返回 结果
结束

导出 函数 replace(文本 字符串, 旧串 字符串, 新串 字符串) -> 字符串
    如果 系统.len(旧串) == 0 那么
        返回 文本
    结束
    变量 位置 = index(文本, 旧串)
    如果 位置 < 0 那么
        返回 文本
    结束
    返回 substring(文本, 0, 位置) + 新串 + substring(文本, 位置 + 系统.len(旧串))
结束

函数 isWhitespace(字符 字符串) -> 布尔
    返回 字符 == " " 或 字符 == "\t" 或 字符 == "\n" 或 字符 == "\r"
结束

导出 函数 trim(文本 字符串) -> 字符串
    当 系统.len(文本) > 0 且 isWhitespace(charAt(文本, 0)) 循环
        文本 = substring(文本, 1)
    结束
    当 系统.len(文本) > 0 且 isWhitespace(charAt(文本, 系统.len(文本) - 1)) 循环
        文本 = substring(文本, 0, 系统.len(文本) - 1)
    结束
    返回 文本
结束

导出 函数 lower(文本 字符串) -> 字符串
    变量 结果 = ""
    遍历 文本 中的 字符
        变量 编码 = 系统.ord(字符)
        如果 编码 >= 65 且 编码 <= 90 那么
            结果 += 系统.char(编码 + 32)
        否则
            结果 += 字符
        结束
    结束
    返回 结果
结束

导出 函数 upper(文本 字符串) -> 字符串
    变量 结果 = ""
    遍历 文本 中的 字符
        变量 编码 = 系统.ord(字符)
        如果 编码 >= 97 且 编码 <= 122 那么
            结果 += 系统.char(编码 - 32)
        否则
            结果 += 字符
        结束
    结束
    返回 结果
结束
