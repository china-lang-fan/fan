导出 函数 fromEntries(配对列表 数组) -> 字典
    变量 结果 = {}
    遍历 配对列表 中的 配对
        结果[配对[0]] = 配对[1]
    结束
    返回 结果
结束

导出 函数 clone(原始 字典) -> 字典
    变量 结果 = {}
    遍历 原始 中的 键 值
        结果[键] = 值
    结束
    返回 结果
结束

导出 函数 merge(目标 字典, 来源 ...字典) -> 字典
    变量 结果 = clone(目标)
    遍历 来源 中的 来源字典
        遍历 来源字典 中的 键 值
            结果[键] = 值
        结束
    结束
    返回 结果
结束

导出 函数 containsKey(原始 字典, 查找键) -> 布尔
    遍历 原始 中的 当前查找键 占位值
        如果 keysEqual(当前查找键, 查找键) 那么
            返回 真
        结束
    结束
    返回 假
结束

导出 函数 get(原始 字典, 查找键)
    返回 原始[查找键]
结束

导出 函数 getOr(原始 字典, 查找键, 默认值)
    如果 containsKey(原始, 查找键) 那么
        返回 原始[查找键]
    结束
    返回 默认值
结束

导出 函数 mapValues(原始 字典, 变换) -> 字典
    变量 结果 = {}
    遍历 原始 中的 键 值
        结果[键] = 变换(值, 键)
    结束
    返回 结果
结束

导出 函数 mapKeys(原始 字典, 变换) -> 字典
    变量 结果 = {}
    遍历 原始 中的 键 值
        结果[变换(值, 键)] = 值
    结束
    返回 结果
结束

导出 函数 filter(原始 字典, 谓词) -> 字典
    变量 结果 = {}
    遍历 原始 中的 键 值
        如果 谓词(值, 键) 那么
            结果[键] = 值
        结束
    结束
    返回 结果
结束

导出 函数 invert(原始 字典) -> 字典
    变量 结果 = {}
    遍历 原始 中的 键 值
        结果[值] = 键
    结束
    返回 结果
结束

导出 函数 pick(原始 字典, 查找键列表 数组) -> 字典
    变量 结果 = {}
    遍历 查找键列表 中的 查找键
        如果 containsKey(原始, 查找键) 那么
            结果[查找键] = 原始[查找键]
        结束
    结束
    返回 结果
结束

导出 函数 omit(原始 字典, 查找键列表 数组) -> 字典
    变量 结果 = clone(原始)
    遍历 查找键列表 中的 查找键
        如果 containsKey(结果, 查找键) 那么
            变量 新结果 = {}
            遍历 结果 中的 当前查找键 值
                如果 非 keysEqual(当前查找键, 查找键) 那么
                    新结果[当前查找键] = 值
                结束
            结束
            结果 = 新结果
        结束
    结束
    返回 结果
结束

导出 函数 countBy(列表 数组, 取值) -> 字典
    变量 结果 = {}
    遍历 列表 中的 项
        变量 查找键 = 取值(项)
        如果 containsKey(结果, 查找键) 那么
            结果[查找键] = 结果[查找键] + 1
        否则
            结果[查找键] = 1
        结束
    结束
    返回 结果
结束
