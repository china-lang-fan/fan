导入 "编码" 作为 编码模块
导入 "文件" 作为 文件模块
导入 "字典" 作为 字典模块
导入 "转换" 作为 转换模块
导入 "系统" 作为 系统模块

@内建("httpRequest")
函数 HTTP请求原语(请求方法, 地址, 选项)
    返回 空, 空
结束

函数 合并请求头(选项, 请求头)
    变量 结果 = {}
    变量 原请求头 = {}
    如果 系统模块.类型名(选项) == "dict" 那么
        变量 键列表 = 字典模块.键列表(选项)
        遍历 键列表 中的 键
            结果[键] = 选项[键]
        结束
        如果 系统模块.类型名(选项["headers"]) == "dict" 那么
            原请求头 = 选项["headers"]
        结束
    结束
    变量 合并后请求头 = {}
    变量 原键列表 = 字典模块.键列表(原请求头)
    遍历 原键列表 中的 键
        合并后请求头[键] = 原请求头[键]
    结束
    变量 新键列表 = 字典模块.键列表(请求头)
    遍历 新键列表 中的 键
        合并后请求头[键] = 请求头[键]
    结束
    结果["headers"] = 合并后请求头
    返回 结果
结束

导出 函数 请求(请求方法 字符串, 地址 字符串, 选项 = 空)
    变量 请求选项 = 选项
    如果 系统模块.类型名(请求选项) != "dict" 那么
        请求选项 = {}
    结束
    返回 HTTP请求原语(请求方法, 地址, 请求选项)
结束

导出 函数 获取(地址 字符串, 选项 = 空)
    返回 请求("GET", 地址, 选项)
结束

导出 函数 提交(地址 字符串, 选项 = 空)
    返回 请求("POST", 地址, 选项)
结束

导出 函数 更新(地址 字符串, 选项 = 空)
    返回 请求("PUT", 地址, 选项)
结束

导出 函数 修补(地址 字符串, 选项 = 空)
    返回 请求("PATCH", 地址, 选项)
结束

导出 函数 删除(地址 字符串, 选项 = 空)
    返回 请求("DELETE", 地址, 选项)
结束

导出 函数 获取JSON(地址 字符串, 选项 = 空)
    变量 结果, 错误值 = 请求("GET", 地址, 合并请求头(选项, {"Accept": "application/json"}))
    如果 错误值 != 空 那么
        返回 空, 错误值
    结束
    如果 !结果["success"] 那么
        返回 空, 系统模块.构造错误("HTTP 请求失败，状态码 " + 转换模块.转字符串(结果["statusCode"]) + "，响应：" + 结果["body"])
    结束
    返回 编码模块.解析JSON(结果["body"])
结束

导出 函数 提交JSON(地址 字符串, 值, 选项 = 空)
    变量 请求体, 编码错误 = 编码模块.生成JSON(值)
    如果 编码错误 != 空 那么
        返回 空, 编码错误
    结束
    变量 请求选项 = 合并请求头(选项, {"Content-Type": "application/json", "Accept": "application/json"})
    请求选项["body"] = 请求体
    变量 结果, 错误值 = 请求("POST", 地址, 请求选项)
    如果 错误值 != 空 那么
        返回 空, 错误值
    结束
    如果 !结果["success"] 那么
        返回 空, 系统模块.构造错误("HTTP 请求失败，状态码 " + 转换模块.转字符串(结果["statusCode"]) + "，响应：" + 结果["body"])
    结束
    返回 编码模块.解析JSON(结果["body"])
结束

导出 函数 下载(地址 字符串, 路径 字符串, 选项 = 空)
    变量 结果, 错误值 = 请求("GET", 地址, 选项)
    如果 错误值 != 空 那么
        返回 错误值
    结束
    如果 !结果["success"] 那么
        返回 系统模块.构造错误("下载失败，状态码 " + 转换模块.转字符串(结果["statusCode"]))
    结束
    返回 文件模块.写入(路径, 结果["body"])
结束
